<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.vincent.tools.dict.infra.mybatis.mapper.DictItemMapper">

    <resultMap id="DictItemPoMap" type="com.vincent.tools.dict.infra.mybatis.po.DictItemPo">
        <id column="id" property="id"/>
        <result column="dict_id" property="dictId"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="code" property="code"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="status" property="status"/>
        <result column="sort_no" property="sortNo"/>
        <result column="version" property="version"/>
        <result column="deleted" property="deleted"/>
        <result column="created_by" property="createdBy"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="selectEffectiveItems" resultMap="DictItemPoMap">
        SELECT id, dict_id, tenant_id, code, name, description, status, sort_no, version, deleted,
               created_by, created_at, updated_by, updated_at
        FROM vin_dict_item
        WHERE dict_id = #{dictId}
          AND deleted = 0
          AND status = 1
          AND tenant_id IN ('0', #{tenantId})
        ORDER BY sort_no, code, id
    </select>
</mapper>
