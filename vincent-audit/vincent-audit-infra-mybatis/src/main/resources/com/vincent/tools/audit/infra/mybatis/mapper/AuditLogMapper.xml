<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.vincent.tools.audit.infra.mybatis.mapper.AuditLogMapper">

    <resultMap id="AuditLogPoMap" type="com.vincent.tools.audit.infra.mybatis.po.AuditLogPo">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="operator_id" property="operatorId"/>
        <result column="action" property="action"/>
        <result column="resource_type" property="resourceType"/>
        <result column="resource_id" property="resourceId"/>
        <result column="before_json" property="beforeJson"/>
        <result column="after_json" property="afterJson"/>
        <result column="client_ip" property="clientIp"/>
        <result column="user_agent" property="userAgent"/>
        <result column="trace_id" property="traceId"/>
        <result column="created_at" property="createdAt"
                typeHandler="com.vincent.tools.audit.infra.mybatis.UtcDateTypeHandler"/>
    </resultMap>

    <sql id="auditLogColumns">
        id, tenant_id, operator_id, action, resource_type, resource_id,
        before_json, after_json, client_ip, user_agent, trace_id, created_at
    </sql>

    <sql id="searchFilters">
        <if test="tenantId != null and tenantId != ''">
            AND tenant_id = #{tenantId}
        </if>
        <if test="operatorId != null and operatorId != ''">
            AND operator_id = #{operatorId}
        </if>
        <if test="action != null and action != ''">
            AND action = #{action}
        </if>
        <if test="resourceType != null and resourceType != ''">
            AND resource_type = #{resourceType}
        </if>
        <if test="resourceId != null and resourceId != ''">
            AND resource_id = #{resourceId}
        </if>
        <if test="createdFrom != null">
            AND created_at &gt;= #{createdFrom, typeHandler=com.vincent.tools.audit.infra.mybatis.UtcDateTypeHandler}
        </if>
        <if test="createdTo != null">
            AND created_at &lt;= #{createdTo, typeHandler=com.vincent.tools.audit.infra.mybatis.UtcDateTypeHandler}
        </if>
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO vin_audit_log (
            tenant_id, operator_id, action, resource_type, resource_id,
            before_json, after_json, client_ip, user_agent, trace_id, created_at
        ) VALUES (
            #{tenantId}, #{operatorId}, #{action}, #{resourceType}, #{resourceId},
            #{beforeJson}, #{afterJson}, #{clientIp}, #{userAgent}, #{traceId},
            #{createdAt, typeHandler=com.vincent.tools.audit.infra.mybatis.UtcDateTypeHandler}
        )
    </insert>

    <select id="countSearch" resultType="long">
        SELECT COUNT(1)
        FROM vin_audit_log
        WHERE 1 = 1
        <include refid="searchFilters"/>
    </select>

    <select id="selectSearch" resultMap="AuditLogPoMap">
        SELECT <include refid="auditLogColumns"/>
        FROM vin_audit_log
        WHERE 1 = 1
        <include refid="searchFilters"/>
        ORDER BY created_at DESC, id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>
</mapper>
